{
  "name": "vistone-saas-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "npm run clean && vite build",
    "build:production": "NODE_ENV=production vite build",
    "build:staging": "NODE_ENV=staging vite build",
    "build:preview": "NODE_ENV=development vite build",
    "build:development": "NODE_ENV=development vite build",
    "lint": "eslint . --quiet",
    "preview": "vite preview",
    "clean": "rimraf dist build .vite node_modules/.cache",
    "clean:all": "rimraf dist build .vite node_modules/.cache && npm install",
    "clean:deep": "powershell -ExecutionPolicy Bypass -File cleanup.ps1",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "analyze": "npm run build && npx vite-bundle-analyzer",
    "api:dev": "nodemon api/server.js",
    "api:start": "node api/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@supabase/supabase-js": "^2.78.0",
    "@tanstack/react-query": "^5.90.6",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.0.0",
    "geoip-lite": "^1.4.10",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.552.0",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "ogl": "^1.0.11",
    "pg": "^8.11.3",
    "razorpay": "^2.9.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^18.2.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "serverless-http": "^3.2.0",
    "socket.io": "^4.7.4",
    "ua-parser-js": "^1.0.37",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
